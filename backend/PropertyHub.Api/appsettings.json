{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PropertyHub;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PropertyHub",
    "Audience": "PropertyHub.Web",
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ImageStorage": {
    "RootPath": "uploads"
  },
  "OpenMeteo": {
    "BaseUrl": "https://api.open-meteo.com",
    "TimeoutSeconds": 5,
    "CacheMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
